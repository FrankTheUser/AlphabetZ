<Window x:Class="AgendaAppleStyle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AlphabetZ" Height="700" Width="980"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#007AFF"/>

        <!-- STILE FLIP CARD OROLOGIO -->
        <Style x:Key="FlipCardTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="SF Pro Display, Segoe UI, Arial"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- STILE GENERALE PER PULSANTI -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007AFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NUVOLETTA DIZIONARIO -->
        <Style x:Key="AppleToolTipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#F21C1C1E" CornerRadius="12" Padding="12,10" MaxWidth="320">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.3" Direction="270" ShadowDepth="4"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="📖 " FontSize="12"/>
                                    <TextBlock Text="Definizione / Info Parola" FontSize="11" FontWeight="Bold" Foreground="#8E8E93"/>
                                </StackPanel>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="13" Foreground="White" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- SFONDO -->
        <Border x:Name="BackgroundLava" CornerRadius="22" Margin="15">
            <Border.Background>
                <LinearGradientBrush x:Name="LavaGradient" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="GradStop1" Color="#007AFF" Offset="0.0"/>
                    <GradientStop x:Name="GradStop2" Color="#5856D6" Offset="0.5"/>
                    <GradientStop x:Name="GradStop3" Color="#FF2D55" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="#000000" Opacity="0.3" Direction="270" ShadowDepth="8"/>
            </Border.Effect>

            <Canvas x:Name="LavaCanvas" ClipToBounds="True">
                <Ellipse x:Name="Bubble1" Width="140" Height="140" Fill="#40FFFFFF" Canvas.Left="100" Canvas.Top="400"/>
                <Ellipse x:Name="Bubble2" Width="200" Height="200" Fill="#30FFFFFF" Canvas.Left="500" Canvas.Top="200"/>
                <Ellipse x:Name="Bubble3" Width="90" Height="90" Fill="#50FFFFFF" Canvas.Left="750" Canvas.Top="500"/>
                <Ellipse x:Name="Bubble4" Width="160" Height="160" Fill="#25FFFFFF" Canvas.Left="300" Canvas.Top="100"/>
            </Canvas>
        </Border>

        <!-- SCHERMATA LOGIN / REGISTRAZIONE -->
        <Grid x:Name="ViewLogin" Margin="15" Visibility="Visible">
            <Button Width="14" Height="14" Click="ChiudiApp_Click" Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="25,20,0,0" Background="Transparent" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Ellipse Fill="#FF5F56"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border Background="#DDFFFFFF" CornerRadius="24" Width="400" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center">
                    <Grid Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Border CornerRadius="16" Background="{StaticResource AccentBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Color="#007AFF" Opacity="0.4" Direction="270" ShadowDepth="3"/>
                            </Border.Effect>
                            <Grid>
                                <TextBlock Text="A" FontSize="18" FontWeight="Bold" Foreground="#88FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,8,0,0"/>
                                <TextBlock Text="Z" FontSize="28" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,2,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock Text="AlphabetZ" FontSize="26" FontWeight="Black" Foreground="#1C1C1E" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtLoginTitolo" Text="Accedi al tuo Notebook A-Z" FontSize="13" Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,2,0,20"/>

                    <TextBlock Text="Nome Utente" FontSize="12" Foreground="#8E8E93" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtUser" Height="38" FontSize="14" Padding="10,8" Background="#F2F2F7" BorderThickness="0" Margin="0,0,0,12"/>

                    <TextBlock Text="Password" FontSize="12" Foreground="#8E8E93" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="TxtPass" Height="38" FontSize="14" Padding="10,8" Background="#F2F2F7" BorderThickness="0" Margin="0,0,0,15"/>

                    <CheckBox x:Name="ChkAutoLogin" Content="Ricorda il login (Accedi in automatico)" FontSize="12" Foreground="#3A3A3C" Margin="0,0,0,20"/>

                    <Button x:Name="BtnSubmit" Content="ENTRA" Click="BtnSubmit_Click" Cursor="Hand" Height="44" Style="{StaticResource RoundedButtonStyle}" FontSize="15"/>

                    <Button x:Name="BtnToggleAuthMode" Content="Non hai un account? Registrati" Click="BtnToggleAuthMode_Click" Foreground="#007AFF" Background="Transparent" BorderThickness="0" Margin="0,15,0,0" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- APPLICAZIONE PRINCIPALE (NOTEBOOK ALPHABETZ) -->
        <Grid x:Name="ViewApp" Margin="15" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="45"/>
            </Grid.ColumnDefinitions>

            <!-- BARRA SUPERIORE -->
            <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="20,15,20,5">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="14" Height="14" Click="ChiudiApp_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Margin="0,0,15,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Ellipse Fill="#FF5F56"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border Width="24" Height="24" CornerRadius="6" Background="White" Margin="0,0,8,0">
                        <TextBlock Text="Z" FontSize="14" FontWeight="Black" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="AlphabetZ" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtDataDettaglio" Text="Lunedì, 12 Ottobre" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,15,0"/>

                    <Border Background="#33000000" CornerRadius="10" Padding="8,4" Margin="0,0,15,0">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CardOre" Width="30" Height="34" Background="#CC1C1C1E" CornerRadius="6" Margin="2,0">
                                <Grid x:Name="GridOre">
                                    <TextBlock x:Name="TxtOre" Text="00" Style="{StaticResource FlipCardTextStyle}"/>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="TxtDots" Text=":" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,2,2"/>

                            <Border x:Name="CardMinuti" Width="30" Height="34" Background="#CC1C1C1E" CornerRadius="6" Margin="2,0">
                                <Grid x:Name="GridMinuti">
                                    <TextBlock x:Name="TxtMinuti" Text="00" Style="{StaticResource FlipCardTextStyle}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Button Content="⚙️ Opzioni" Click="BtnOpzioni_Click" Foreground="White" FontWeight="Bold" Background="#44FFFFFF" BorderThickness="0" Padding="12,5" Cursor="Hand" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- FORM NUOVA FRASE -->
            <Border Grid.Row="1" Grid.Column="0" Background="#CCFFFFFF" CornerRadius="12" Margin="25,5,15,10" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtNuovaFrase" BorderThickness="0" FontSize="14" VerticalAlignment="Center" Background="Transparent" Foreground="#1C1C1E" KeyDown="TxtNuovaFrase_KeyDown" Text="Scrivi una nuova parola e premi Invio..."/>
                    <Button Grid.Column="1" Click="BtnAggiungi_Click" Style="{StaticResource RoundedButtonStyle}" Padding="15,6" Content="+ Aggiungi" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- CARTA NOTEBOOK -->
            <Border x:Name="PaperBorder" Grid.Row="2" Grid.Column="0" Background="#FDFBF7" CornerRadius="16" Margin="25,5,15,20" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="10,0,0,10">
                        <TextBlock x:Name="TxtWelcome" Text="Benvenuto!" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock x:Name="TxtIngestazioneLettera" Text=" - Le mie parole" FontSize="18" FontWeight="SemiBold" Foreground="#3A3A3C" VerticalAlignment="Bottom" Margin="5,0,0,2"/>
                    </StackPanel>

                    <!-- LISTA CON TOOLTIP DINAMICO -->
                    <ListBox x:Name="ListaFrasi" Grid.Row="1" Background="Transparent" BorderThickness="0" MouseDoubleClick="ListaFrasi_MouseDoubleClick" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border BorderBrush="#E5E5EA" BorderThickness="0,0,0,1" Padding="10,12" Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="16" FontFamily="Segoe UI" Foreground="#2C2C2E" Cursor="Help" ToolTipOpening="TextBlock_ToolTipOpening" Style="{x:Null}">
                                    <TextBlock.ToolTip>
                                        <ToolTip Style="{StaticResource AppleToolTipStyle}" Content="Caricamento in corso..."/>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- INDICE A-Z -->
            <Border Grid.Row="2" Grid.Column="1" Background="#33FFFFFF" CornerRadius="12" Margin="0,5,12,20" Padding="0,6">
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="ListaAlfabeto">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Click="Lettera_Click" Foreground="White" FontWeight="Bold" FontSize="11" Height="20" Width="20" Margin="0,1" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Background="Transparent">
                                                <Ellipse x:Name="HoverCircle" Fill="#55FFFFFF" Opacity="0"/>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HoverCircle" Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- PANNELLO OPZIONI -->
        <Border x:Name="PanelOpzioni" Background="#EEFFFFFF" CornerRadius="20" Width="420" Height="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.2"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="⚙️ Impostazioni AlphabetZ" FontSize="20" FontWeight="Bold" Foreground="#1C1C1E" Margin="0,0,0,20"/>

                <TextBlock Text="Tema Lava Lamp" FontSize="13" FontWeight="SemiBold" Foreground="#8E8E93" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Button Width="30" Height="30" Margin="0,0,10,0" Click="CambiaColore_Click" Tag="Blu" Cursor="Hand" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Ellipse Fill="#007AFF"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Width="30" Height="30" Margin="0,0,10,0" Click="CambiaColore_Click" Tag="Rosa" Cursor="Hand" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Ellipse Fill="#FF2D55"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Width="30" Height="30" Margin="0,0,10,0" Click="CambiaColore_Click" Tag="Smeraldo" Cursor="Hand" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Ellipse Fill="#34C759"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Width="30" Height="30" Margin="0,0,10,0" Click="CambiaColore_Click" Tag="Viola" Cursor="Hand" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Ellipse Fill="#AF52DE"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <TextBlock Text="Accesso &amp; Account" FontSize="13" FontWeight="SemiBold" Foreground="#8E8E93" Margin="0,0,0,8"/>
                <CheckBox x:Name="ChkAutoLoginSettings" Content="Ricorda sempre il login all'avvio" Checked="ChkAutoLoginSettings_Changed" Unchecked="ChkAutoLoginSettings_Changed" Margin="0,0,0,20"/>

                <Button Content="🚪 Logout (Disconnetti)" Click="BtnLogout_Click" Foreground="#FF3B30" Background="Transparent" BorderThickness="0" FontWeight="Bold" HorizontalAlignment="Left" Cursor="Hand" Margin="0,0,0,25"/>

                <Button Content="Chiudi Opzioni" Click="BtnChiudiOpzioni_Click" Height="38" Style="{StaticResource RoundedButtonStyle}" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>